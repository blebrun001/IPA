    "Standard scans the full texture. Tiling splits the texture into tiles to detect tiny QR codes. Auto chooses for you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard analitza tota la textura. Tiling divideix la textura en mosaics per detectar codis QR molt petits. Auto tria per tu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard scans the full texture. Tiling splits the texture into tiles to detect tiny QR codes. Auto chooses for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard analiza toda la textura. Tiling divide la textura en mosaicos para detectar QR muy pequeños. Auto elige por ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard analyse la texture entière. Tiling découpe la texture en tuiles pour détecter de très petits codes QR. Auto décide pour vous."
          }
        }
      }
